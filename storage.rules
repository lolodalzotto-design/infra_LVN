rules_version = '2';
// Deployment managed by GitHub Actions.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isPasswordUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isBootstrapAdmin() {
      return isPasswordUser()
        && request.auth.token.email == 'lolo.dalzotto@gmail.com';
    }

    function hasInfraProfile() {
      return isPasswordUser()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isInfra() {
      return isBootstrapAdmin()
        || (hasInfraProfile()
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'infra']);
    }

    function validImageUpload() {
      return request.resource != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /reports/{uid}/{fileName} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && validImageUpload();

      allow read: if (signedIn() && request.auth.uid == uid) || isInfra();
      allow update: if isInfra() && validImageUpload();
      allow delete: if isInfra();
    }

    match /hcc-reports/{uid}/{fileName} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && validImageUpload();

      allow read: if (signedIn() && request.auth.uid == uid) || isInfra();
      allow update: if isInfra() && validImageUpload();
      allow delete: if isInfra();
    }

    match /resolutions/{uid}/{fileName} {
      allow read: if isInfra();
      allow create, update: if isInfra() && validImageUpload();
      allow delete: if isInfra();
    }
  }
}
