rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // Compte Infra commun autorisé.
    function isInfra() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'lolo.dalzotto@gmail.com';
    }

    function validImageUpload() {
      return request.resource != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /reports/{uid}/{fileName} {
      // L'agent anonyme peut envoyer/lire uniquement sa propre photo.
      allow create: if signedIn()
        && request.auth.uid == uid
        && validImageUpload();

      allow read: if (signedIn() && request.auth.uid == uid) || isInfra();
      allow update: if isInfra() && validImageUpload();
      allow delete: if isInfra();
    }

    match /resolutions/{uid}/{fileName} {
      allow read: if isInfra();
      allow create, update: if isInfra() && validImageUpload();
      allow delete: if isInfra();
    }
  }
}
