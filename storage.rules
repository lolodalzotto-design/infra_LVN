rules_version = '2';
// Deployment managed by GitHub Actions.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isPasswordUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isBootstrapAdmin() {
      return isPasswordUser()
        && request.auth.token.email == 'lolo.dalzotto@gmail.com';
    }

    function hasProfile() {
      return isPasswordUser() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function isSector(sector) {
      return isBootstrapAdmin()
        || (hasProfile() && profile().active == true && profile().sector == 'both' && profile().role == 'moderator')
        || (hasProfile() && profile().active == true && profile().sector == sector && profile().role in ['admin','user']);
    }
    function isAnonymous() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    // Lecture de sa propre photo : visiteur anonyme, ou compte au profil actif.
    function canReadOwn(uid) {
      return signedIn() && request.auth.uid == uid
        && (isAnonymous() || isBootstrapAdmin() || (hasProfile() && profile().active == true));
    }
    function isInfra() { return isSector('infra'); }
    function isHcc() { return isSector('hcc'); }

    function validImageUpload() {
      return request.resource != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /reports/{uid}/{fileName} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && validImageUpload();

      allow read: if canReadOwn(uid) || isInfra();
      allow update: if isInfra() && validImageUpload();
      allow delete: if isInfra();
    }

    match /hcc-reports/{uid}/{fileName} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && validImageUpload();

      allow read: if canReadOwn(uid) || isHcc();
      allow update: if isHcc() && validImageUpload();
      allow delete: if isHcc();
    }

    match /resolutions/{uid}/{fileName} {
      allow read: if isInfra();
      allow create, update: if isInfra() && validImageUpload();
      allow delete: if isInfra();
    }
  }
}
