rules_version = '2';
// Deployment managed by GitHub Actions.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isPasswordUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // Compte administrateur historique. Ce garde-fou permet d'amorcer
    // automatiquement son profil administrateur dans /users/{uid}.
    function isBootstrapAdmin() {
      return isPasswordUser()
        && request.auth.token.email == 'lolo.dalzotto@gmail.com';
    }

    function hasInfraProfile() {
      return isPasswordUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function infraProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isInfra() {
      return isBootstrapAdmin()
        || (hasInfraProfile()
          && infraProfile().active == true
          && infraProfile().role in ['admin', 'infra']);
    }

    function isAdmin() {
      return isBootstrapAdmin()
        || (hasInfraProfile()
          && infraProfile().active == true
          && infraProfile().role == 'admin');
    }

    function validInfraProfile(uid) {
      return request.resource.data.keys().hasOnly([
          'firstName', 'lastName', 'email', 'role', 'active',
          'createdAt', 'updatedAt', 'createdByUid'
        ])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 60
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 60
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 160
        && request.resource.data.role in ['admin', 'infra']
        && request.resource.data.active is bool
        && request.resource.data.createdByUid is string;
    }

    function validPublicReport() {
      return request.resource.data.keys().hasOnly([
          'roomId', 'roomName', 'buildingId', 'levelId',
          'reporterFirstName', 'reporterLastName',
          'description', 'category', 'urgent', 'source', 'sector',
          'status', 'createdAt', 'updatedAt', 'resolvedAt',
          'resolutionComment', 'resolutionPhotoUrl',
          'history', 'photoUrl'
        ])
        && request.resource.data.source == 'public'
        && request.resource.data.sector == 'INFRA'
        && request.resource.data.status == 'a_traiter'
        && request.resource.data.roomId is string
        && request.resource.data.roomName is string
        && request.resource.data.buildingId in ['A', 'B']
        && request.resource.data.levelId in ['RDC', 'R1', 'R2']
        && request.resource.data.reporterFirstName is string
        && request.resource.data.reporterFirstName.size() > 0
        && request.resource.data.reporterFirstName.size() <= 60
        && request.resource.data.reporterLastName is string
        && request.resource.data.reporterLastName.size() > 0
        && request.resource.data.reporterLastName.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 240
        && request.resource.data.category is string
        && request.resource.data.urgent is bool
        && request.resource.data.resolvedAt == null
        && request.resource.data.resolutionComment == ''
        && request.resource.data.resolutionPhotoUrl == null;
    }

    function validPublicHccRequest() {
      return request.resource.data.keys().hasOnly([
          'roomId', 'roomName', 'buildingId', 'levelId', 'zoneId',
          'reporterFirstName', 'reporterLastName', 'description',
          'urgent', 'source', 'sector', 'status', 'createdAt', 'updatedAt', 'photoUrl'
        ])
        && request.resource.data.source == 'public'
        && request.resource.data.sector == 'HCC'
        && request.resource.data.status == 'a_traiter'
        && request.resource.data.urgent is bool
        && request.resource.data.roomId is string
        && request.resource.data.roomName is string
        && request.resource.data.buildingId in ['A', 'B']
        && request.resource.data.levelId in ['RDC', 'R1', 'R2']
        && request.resource.data.zoneId is string
        && request.resource.data.reporterFirstName is string
        && request.resource.data.reporterFirstName.size() > 0
        && request.resource.data.reporterFirstName.size() <= 60
        && request.resource.data.reporterLastName is string
        && request.resource.data.reporterLastName.size() > 0
        && request.resource.data.reporterLastName.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 240;
    }

    match /users/{uid} {
      // Un membre peut lire son propre profil. L'administrateur voit tous
      // les membres afin de gérer les autorisations.
      allow read: if isAdmin() || (isPasswordUser() && request.auth.uid == uid);

      // Le compte administrateur historique peut créer son propre profil
      // admin à la première connexion. Tous les autres comptes sont "infra".
      allow create: if isAdmin()
        && validInfraProfile(uid)
        && (
          (uid == request.auth.uid
            && isBootstrapAdmin()
            && request.resource.data.role == 'admin'
            && request.resource.data.active == true)
          || (uid != request.auth.uid && request.resource.data.role == 'infra')
        );

      // Les rôles ne sont jamais modifiables depuis le navigateur.
      // Le profil admin ne peut pas être désactivé.
      allow update: if isAdmin()
        && validInfraProfile(uid)
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && (
          resource.data.role != 'admin'
          || request.resource.data.active == true
        );

      // On conserve les profils pour l'audit ; une révocation passe par active=false.
      allow delete: if false;
    }

    match /room_status/{roomId} {
      allow read: if true;

      allow create, update: if (
          isAnonymous()
          && request.resource.data.keys().hasOnly(['active', 'updatedAt'])
          && request.resource.data.active == true
        ) || isInfra();

      allow delete: if isInfra();
    }

    match /hcc_requests/{requestId} {
      allow create: if (isAnonymous() && validPublicHccRequest()) || isInfra();
      allow read, update, delete: if isInfra();
    }

    match /anomalies/{anomalyId} {
      allow create: if (isAnonymous() && validPublicReport()) || isInfra();
      allow read, update, delete: if isInfra();
    }
  }
}
