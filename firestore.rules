rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Compte Infra commun autorisé.
    function isInfra() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'lolo.dalzotto@gmail.com';
    }

    function validPublicReport() {
      return request.resource.data.keys().hasOnly([
          'roomId', 'roomName', 'buildingId', 'levelId',
          'reporterFirstName', 'reporterLastName',
          'description', 'category', 'urgent', 'source',
          'status', 'createdAt', 'updatedAt', 'resolvedAt',
          'resolutionComment', 'resolutionPhotoUrl',
          'history', 'photoUrl'
        ])
        && request.resource.data.source == 'public'
        && request.resource.data.status == 'a_traiter'
        && request.resource.data.roomId is string
        && request.resource.data.roomName is string
        && request.resource.data.buildingId in ['A', 'B']
        && request.resource.data.levelId in ['RDC', 'R1', 'R2']
        && request.resource.data.reporterFirstName is string
        && request.resource.data.reporterFirstName.size() > 0
        && request.resource.data.reporterFirstName.size() <= 60
        && request.resource.data.reporterLastName is string
        && request.resource.data.reporterLastName.size() > 0
        && request.resource.data.reporterLastName.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 240
        && request.resource.data.category is string
        && request.resource.data.urgent is bool
        && request.resource.data.resolvedAt == null
        && request.resource.data.resolutionComment == ''
        && request.resource.data.resolutionPhotoUrl == null;
    }

    match /anomalies/{anomalyId} {
      // L'agent terrain est authentifié anonymement de façon invisible.
      // Il peut uniquement créer son signalement.
      allow create: if (isAnonymous() && validPublicReport()) || isInfra();

      // Lecture et gestion réservées au compte Infra commun.
      allow read, update, delete: if isInfra();
    }
  }
}
