rules_version = '2';
// Deployment managed by GitHub Actions.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isPasswordUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // Compte administrateur historique. Ce garde-fou permet d'amorcer
    // automatiquement son profil administrateur dans /users/{uid}.
    function isBootstrapAdmin() {
      return isPasswordUser()
        && request.auth.token.email == 'lolo.dalzotto@gmail.com';
    }

    function hasProfile() {
      return isPasswordUser() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function profileSector() {
      return profile().sector;
    }
    function normalizedRole() {
      return profile().role == 'infra' ? 'user' : profile().role;
    }
    function isSector(sector) {
      return isBootstrapAdmin()
        || (hasProfile() && profile().active == true && normalizedRole() == 'moderator' && profileSector() == 'both')
        || (hasProfile() && profile().active == true && profileSector() == sector && normalizedRole() in ['admin','user']);
    }
    function isSectorAdmin(sector) {
      return isBootstrapAdmin()
        || (hasProfile() && profile().active == true && profileSector() == sector && normalizedRole() == 'admin');
    }
    // Administrateur cloisonné à un seul secteur (jamais 'both', jamais l'exception historique).
    function isServiceAdmin() {
      return hasProfile() && profile().active == true && normalizedRole() == 'admin'
        && profileSector() in ['infra','hcc'];
    }
    function isInfra() { return isSector('infra'); }
    function isHcc() { return isSector('hcc'); }
    function isAdmin() { return isBootstrapAdmin() || (hasProfile() && profile().active == true && normalizedRole() == 'admin'); }

    function validUserProfile(uid) {
      return request.resource.data.keys().hasOnly([
          'username','usernameKey','sector','role','active','authEmail',
          'firstName','lastName','email','createdAt','updatedAt','createdByUid'
        ])
        && request.resource.data.active is bool
        && request.resource.data.createdByUid is string
        && (
          (request.resource.data.username is string
            && request.resource.data.username.size() > 0
            && request.resource.data.username.size() <= 60
            && request.resource.data.usernameKey is string
            && request.resource.data.usernameKey.size() > 0
            && request.resource.data.sector in ['infra','hcc','both']
            && request.resource.data.role in ['admin','user','moderator']
            && (request.resource.data.role != 'moderator' || request.resource.data.sector == 'both')
            && (request.resource.data.sector != 'both' || request.resource.data.role == 'moderator')
            && request.resource.data.authEmail is string)
          ||
          (request.resource.data.firstName is string
            && request.resource.data.lastName is string
            && request.resource.data.email is string
            && request.resource.data.role in ['admin','infra'])
        );
    }

    function validPublicReport() {
      return request.resource.data.keys().hasOnly([
          'roomId', 'roomName', 'buildingId', 'levelId',
          'reporterFirstName', 'reporterLastName',
          'description', 'category', 'urgent', 'source', 'sector',
          'status', 'createdAt', 'updatedAt', 'resolvedAt',
          'resolutionComment', 'resolutionPhotoUrl',
          'history', 'photoUrl'
        ])
        && request.resource.data.source == 'public'
        && request.resource.data.sector == 'INFRA'
        && request.resource.data.status == 'a_traiter'
        && request.resource.data.roomId is string
        && request.resource.data.roomName is string
        && request.resource.data.buildingId in ['A', 'B']
        && request.resource.data.levelId in ['RDC', 'R1', 'R2']
        && request.resource.data.reporterFirstName is string
        && request.resource.data.reporterFirstName.size() > 0
        && request.resource.data.reporterFirstName.size() <= 60
        && request.resource.data.reporterLastName is string
        && request.resource.data.reporterLastName.size() > 0
        && request.resource.data.reporterLastName.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 240
        && request.resource.data.category is string
        && request.resource.data.urgent is bool
        && request.resource.data.resolvedAt == null
        && request.resource.data.resolutionComment == ''
        && request.resource.data.resolutionPhotoUrl == null;
    }

    function validPublicHccRequest() {
      return request.resource.data.keys().hasOnly([
          'roomId', 'roomName', 'buildingId', 'levelId', 'zoneId',
          'reporterFirstName', 'reporterLastName', 'description',
          'urgent', 'source', 'sector', 'status', 'createdAt', 'updatedAt', 'history', 'photoUrl'
        ])
        && request.resource.data.source == 'public'
        && request.resource.data.sector == 'HCC'
        && request.resource.data.status == 'a_traiter'
        && request.resource.data.urgent is bool
        && request.resource.data.roomId is string
        && request.resource.data.roomName is string
        && request.resource.data.buildingId in ['A', 'B']
        && request.resource.data.levelId in ['RDC', 'R1', 'R2']
        && request.resource.data.zoneId is string
        && request.resource.data.reporterFirstName is string
        && request.resource.data.reporterFirstName.size() > 0
        && request.resource.data.reporterFirstName.size() <= 60
        && request.resource.data.reporterLastName is string
        && request.resource.data.reporterLastName.size() > 0
        && request.resource.data.reporterLastName.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 240;
    }

    match /users/{uid} {
      allow read: if isPasswordUser() && (
        request.auth.uid == uid
        || isBootstrapAdmin()
        || (isServiceAdmin() && resource.data.get('sector', '') == profileSector())
      );

      allow create: if validUserProfile(uid) && (
        (uid == request.auth.uid && isBootstrapAdmin())
        || (isBootstrapAdmin() && request.resource.data.sector in ['infra','hcc','both'])
        || (isServiceAdmin()
            && request.resource.data.sector == profileSector()
            && request.resource.data.role == 'user'
            && request.resource.data.createdByUid == request.auth.uid
            && request.resource.data.authEmail is string
            && request.resource.data.authEmail.matches('^[a-z0-9._-]+[.]' + profileSector() + '@lvn[.]local$'))
      );

      allow update: if validUserProfile(uid)
        && (
          isBootstrapAdmin()
          // Administrateur de service : uniquement activer/désactiver un compte "user" de son secteur.
          || (isServiceAdmin()
              && uid != request.auth.uid
              && resource.data.get('sector', '') == profileSector()
              && resource.data.role == 'user'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','updatedAt']))
        );

      allow delete: if false;
    }

    match /room_status/{roomId} {
      allow read: if true;

      allow create, update: if (
          isAnonymous()
          && request.resource.data.keys().hasOnly(['active', 'updatedAt'])
          && request.resource.data.active == true
        ) || isInfra();

      allow delete: if isInfra();
    }

    match /hcc_requests/{requestId} {
      allow create: if (isAnonymous() && validPublicHccRequest()) || isHcc();
      allow read, update, delete: if isHcc();
    }

    match /anomalies/{anomalyId} {
      allow create: if (isAnonymous() && validPublicReport()) || isInfra();
      allow read, update, delete: if isInfra();
    }
  }
}
